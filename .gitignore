# ── Credentials & secrets (NEVER commit these) ────────────────────────────────
.env
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/

# ── Bot runtime data ──────────────────────────────────────────────────────────
data/state.json
data/recordings/
data/*.db
data/exclusions.json
data/runtime/
*.db
*.sqlite
*.sqlite3

# ── Runtime state — generated at runtime, do not commit ──────────────────────
data/runtime/*.json
data/runtime/*.jsonl
data/runtime/*.jsonl.bak.*
data/runtime/*.log
data/runtime/*.txt

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# ── Claude Code / Codex local config (may contain API keys or personal settings)
.claude/settings.local.json
.codex/
.tracecov/

# ── Misc ──────────────────────────────────────────────────────────────────────
*.docx
