# ── Platform toggles ──────────────────────────────────────────────────────────
# Set to false to disable a platform (no credentials needed when false)
KALSHI_ENABLED=true
POLYMARKET_ENABLED=true

# ── Kalshi ────────────────────────────────────────────────────────────────────
KALSHI_API_KEY=your_kalshi_api_key_here
KALSHI_API_SECRET=your_kalshi_api_secret_here
KALSHI_ENV=demo   # demo | prod  — use demo until ready to trade live

# ── Polymarket ────────────────────────────────────────────────────────────────
POLYMARKET_API_KEY=your_polymarket_api_key_here
POLYMARKET_API_SECRET=your_polymarket_api_secret_here
POLYMARKET_API_PASSPHRASE=your_polymarket_passphrase_here
POLYMARKET_PRIVATE_KEY=your_polygon_wallet_private_key_here
POLYMARKET_FUNDER_ADDRESS=your_polygon_wallet_address_here

# ── Core settings ─────────────────────────────────────────────────────────────
# Master kill switch – true = no real orders ever placed
DRY_RUN=true
# Total capital in USD
BANKROLL_USD=1000.0

# ── Shared infrastructure ─────────────────────────────────────────────────────
# How long to cache fee rates before re-fetching (seconds). Default 15 min.
# CRITICAL: fee rates change. Never hardcode. Always query before trading.
FEE_CACHE_TTL_SECONDS=900

# ── Bankroll split ────────────────────────────────────────────────────────────
# Fraction of total bankroll allocated to the maker bot. Rest goes to resolution.
# Strategy spec: 60% maker / 40% resolution.
MAKER_ALLOCATION_FRACTION=0.60

# ── Bot 1: Maker Rebate Harvester ─────────────────────────────────────────────
# Enable/disable the maker bot entirely
MAKER_ENABLED=true
# Half-spread to post around fair value (0.010 = 1 cent on a $1 binary)
# Widen if adverse selection losses consistently exceed rebates
MAKER_HALF_SPREAD=0.010
# Per-market per-side exposure cap in USD. Start small ($50-100).
MAKER_CAP_USD=75.0

# ── Bot 2: Resolution Drift Arbitrage ─────────────────────────────────────────
# Enable/disable the resolution bot entirely
RESOLUTION_ENABLED=true
# Only scan markets expiring within this many hours (strategy spec: 24h)
RESOLUTION_WINDOW_HOURS=24.0
# Minimum fee-adjusted probability gap to flag a market (strategy spec: 4%)
RESOLUTION_MIN_GAP=0.04
# Fractional Kelly multiplier for resolution trades (strategy spec: 10-15%)
# These markets are thin – stay conservative
RESOLUTION_KELLY_FRACTION=0.12
# Hard cap: max single resolution position as fraction of total bankroll (20%)
RESOLUTION_MAX_POSITION_FRACTION=0.20

# ── Monitoring & alerts ───────────────────────────────────────────────────────
# Telegram: get token from @BotFather; get chat_id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord: create an Incoming Webhook in Server Settings → Integrations
DISCORD_WEBHOOK_URL=
# Alert when daily drawdown exceeds this fraction of bankroll (0.05 = 5%)
DAILY_DRAWDOWN_ALERT_PCT=0.05
# Halt ALL trading when combined daily loss exceeds this USD amount (0 = disabled)
MAX_DAILY_LOSS_USD=0
# How often to write a portfolio snapshot to the DB (seconds)
SNAPSHOT_INTERVAL_SECONDS=60
