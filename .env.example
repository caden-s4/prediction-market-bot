# ── Platform toggles ──────────────────────────────────────────────────────────
# Set to false to disable a platform entirely (no credentials required when false)
KALSHI_ENABLED=true
POLYMARKET_ENABLED=true

# ── Kalshi ────────────────────────────────────────────────────────────────────
KALSHI_API_KEY=your_kalshi_api_key_here
# RSA private key – paste the full PEM key on ONE line with literal \n escapes:
# KALSHI_API_SECRET="-----BEGIN PRIVATE KEY-----\nMIIE...(full base64)...\n-----END PRIVATE KEY-----"
# To convert a .pem file: python -c "import sys; print(open(sys.argv[1]).read().replace(chr(10),'\\\\n'))" key.pem
KALSHI_API_SECRET=your_kalshi_rsa_private_key_here
# demo = Kalshi paper trading (long-dated test markets only)
# prod = live trading (real short-dated markets, real money)
# NOTE: Kalshi demo only has markets expiring 7-30+ days out. Set KALSHI_ENV=prod
#       and RESOLUTION_WINDOW_HOURS=24 for the full 24h resolution drift strategy.
KALSHI_ENV=demo

# ── Polymarket ────────────────────────────────────────────────────────────────
POLYMARKET_API_KEY=your_polymarket_api_key_here
POLYMARKET_API_SECRET=your_polymarket_api_secret_here
POLYMARKET_API_PASSPHRASE=your_polymarket_passphrase_here
POLYMARKET_PRIVATE_KEY=your_polygon_wallet_private_key_here
POLYMARKET_FUNDER_ADDRESS=your_polygon_wallet_address_here

# ── Core settings ─────────────────────────────────────────────────────────────
# Master kill switch – true = log everything, place nothing
DRY_RUN=true
# Total capital in USD
BANKROLL_USD=1000.0

# ── Shared infrastructure ─────────────────────────────────────────────────────
# Fee rate cache TTL in seconds. NEVER hardcode fees – Polymarket rolls them
# out constantly. Default 15 min (900s). Do not raise above 900.
FEE_CACHE_TTL_SECONDS=900

# ── Resolution Drift Arbitrage ────────────────────────────────────────────────
# Scan window: only trade markets expiring within this many hours.
# STRATEGY SPEC: 24h for live production trading.
# FOR DEMO/TESTING: set to 168 (1 week) or 720 (30 days) since Kalshi demo
# only has long-dated markets.
RESOLUTION_WINDOW_HOURS=720

# Minimum probability gap after fees to flag a market (strategy spec: 4%)
# Lower = more signals but more noise. Don't go below 3%.
RESOLUTION_MIN_GAP=0.04

# Fractional Kelly multiplier. These books are thin – stay conservative.
# Strategy spec: 10-15%. Default: 12%.
RESOLUTION_KELLY_FRACTION=0.12

# Hard cap: max single position as fraction of total bankroll (strategy spec: 20%)
RESOLUTION_MAX_POSITION_FRACTION=0.20

# How often to run a full scan cycle in seconds (default 300 = 5 min)
RESOLUTION_SCAN_INTERVAL_SECONDS=300

# ── Financial data API keys (optional but strongly recommended) ───────────────
# Twelve Data: free tier is generous. Get a key at https://twelvedata.com/apikey
# Without this key FinancialDataSource falls back to unofficial Yahoo Finance
# endpoints that break periodically.  Takes 5 minutes — do this before live trading.
TWELVE_DATA_KEY=

# FRED API key: free, needed for scheduled-release suppression (prevents trading
# on stale data the day before a monthly CPI/unemployment release).
# Get one at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ── Monitoring & alerts ───────────────────────────────────────────────────────
# Telegram: get token from @BotFather; chat_id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord: Server Settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=
# Alert when daily drawdown exceeds this fraction of bankroll (0.05 = 5%)
DAILY_DRAWDOWN_ALERT_PCT=0.05
# Halt ALL trading when daily loss exceeds this USD amount (0 = disabled)
# REQUIRED before going live. Set to 10-15% of your bankroll.
# Example: MAX_DAILY_LOSS_USD=50 for a $500 bankroll.
# The bot will log a WARNING at startup if this is 0 and DRY_RUN=false.
MAX_DAILY_LOSS_USD=0
# How often to write a portfolio snapshot (seconds)
SNAPSHOT_INTERVAL_SECONDS=60
